# ─── Database ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://cloudvault:cloudvault_password@localhost:5432/cloudvault

# ─── Object Storage ────────────────────────────────────────────────
# LOCAL DEV (MinIO) — comment these out for production
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123

# PRODUCTION (AWS S3) — uncomment and fill these for production
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=<your-aws-access-key>
# S3_SECRET_ACCESS_KEY=<your-aws-secret-key>

AWS_REGION=us-east-1
S3_PRIMARY_BUCKET=cloudvault-primary
S3_REPLICA_BUCKET=cloudvault-replica
S3_BACKUP_BUCKET=cloudvault-backups
S3_REPLICA_REGION=us-west-2

# ─── Auth (JWT) ────────────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_generate_random_64_chars
JWT_REFRESH_SECRET=CHANGE_ME_generate_another_random_64_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── OAuth ─────────────────────────────────────────────────────────
# Google — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

OAUTH_CALLBACK_URL=http://localhost:4000/api/auth

# ─── App ───────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ─── Upload Limits ─────────────────────────────────────────────────
MAX_FILE_SIZE_BYTES=5368709120
MULTIPART_THRESHOLD_BYTES=104857600
